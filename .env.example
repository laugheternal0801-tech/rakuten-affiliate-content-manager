# 任意: Claude Sonnet 5で投稿案を生成します。未設定時はテンプレート生成を使います。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_TIMEOUT_SECONDS=120

# 任意: GPT Image 2でnote記事のアイキャッチ画像を生成します。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_TIMEOUT_SECONDS=150

# AI会議を使う場合は、上記OpenAI・Anthropicと合わせてGeminiの3キーすべてが必要です。
GEMINI_API_KEY=
# GOOGLE_API_KEY は GEMINI_API_KEY の代替名としても利用できます。
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# AI会議は各社の最高クラスモデルを別プロセスで実行します。
AI_COUNCIL_OPENAI_MODEL=gpt-5.6-sol
AI_COUNCIL_ANTHROPIC_MODEL=claude-fable-5-1
AI_COUNCIL_GEMINI_MODEL=gemini-3.1-pro-preview
AI_COUNCIL_TIMEOUT_SECONDS=900
AI_COUNCIL_MAX_OUTPUT_TOKENS=16000

# AI Operating System: 二重承認。falseの間は各Runで許可しても外部AIを呼びません。
AI_OS_EXTERNAL_API_ENABLED=false
# trueの間はAPIキーがあっても外部AIを呼びません。最後の実接続時だけfalseにします。
AI_OS_MOCK_MODE=true
AI_OS_DAILY_BUDGET_USD=1.0
AI_OS_MAX_RUN_COST_USD=0.25
AI_OS_MAX_MODEL_CALLS_PER_RUN=5
AI_OS_MAX_SEARCH_CALLS_PER_RUN=1
AI_OS_LLM_CACHE_TTL_SECONDS=86400
# 請求単価ではなく、Run予算を守るための1呼び出し当たり安全側見積り（USD）です。
AI_PROVIDER_COST_RESERVES_USD={"demo":0.0,"openai":0.03,"anthropic":0.04,"gemini":0.01}
# Phase 1のRule-based Router用メタデータ。後から計測値・動的Routerへ置換できます。
AI_PROVIDER_QUALITY={"demo":0.35,"openai":0.88,"anthropic":0.90,"gemini":0.82}
AI_PROVIDER_LATENCY_MS={"demo":10,"openai":5000,"anthropic":5500,"gemini":3500}
AI_PROVIDER_CONTEXT_TOKENS={"demo":2000000,"openai":200000,"anthropic":200000,"gemini":1000000}

# SNS Market Intelligence: 公式API認証（値は画面やログへ表示しません）
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sns-market-intelligence/0.1
YOUTUBE_API_KEY=

# 将来の承認済みConnector用。現行版では手動Importへ安全に縮退します。
TIKTOK_API_KEY=
META_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=

# 手動Importは指定フォルダ内の x/reddit/youtube/tiktok/instagram/pinterest/web.json|csv を読みます。
MARKET_INTELLIGENCE_MANUAL_IMPORT_DIR=
# 任意のサイト巡回はせず、カンマ区切りで明示したRSS/Atomだけを読みます。
MARKET_INTELLIGENCE_WEB_FEED_URLS=
MARKET_INTELLIGENCE_TIMEOUT_SECONDS=30
MARKET_INTELLIGENCE_MAX_CONCURRENCY=5
MARKET_INTELLIGENCE_MAX_RETRIES=2
MARKET_INTELLIGENCE_CACHE_TTL_SECONDS=3600
MARKET_INTELLIGENCE_PLATFORM_WEIGHTS={"x":1.0,"reddit":0.8,"youtube":1.0,"tiktok":1.0,"instagram":1.0,"pinterest":0.7,"web":1.0}
MARKET_INTELLIGENCE_CONFIDENCE_WEIGHTS={"evidence_volume":0.20,"source_diversity":0.15,"platform_diversity":0.15,"temporal_consistency":0.10,"model_agreement":0.15,"data_quality":0.20,"counter_evidence":0.05}

# 既定値は data/app.db。PostgreSQL等へ差し替える場合もSQLAlchemy URLを使います。
DATABASE_URL=sqlite:///data/app.db

# AI Creative Production System
# 初期状態では外部生成APIを呼びません。すべての設定と疎通試験を終えた後だけtrueへ変更します。
CREATIVE_EXTERNAL_API_ENABLED=false
CREATIVE_ASSET_DIR=
CREATIVE_DEFAULT_QUALITY_LEVEL=standard
CREATIVE_DEFAULT_BUDGET_USD=0
CREATIVE_MAX_REVISION_ROUNDS=2
CREATIVE_CANDIDATES_DRAFT=2
CREATIVE_CANDIDATES_STANDARD=3
CREATIVE_CANDIDATES_PREMIUM=4
CREATIVE_CANDIDATES_FLAGSHIP=6

# Model名は契約アカウントで利用可能な値を最後に設定してください。
CREATIVE_OPENAI_IMAGE_MODEL=
CREATIVE_GOOGLE_IMAGE_MODEL=
CREATIVE_GOOGLE_VIDEO_MODEL=
CREATIVE_XAI_API_KEY=
CREATIVE_XAI_MODEL=
CREATIVE_FLUX_API_KEY=
CREATIVE_FLUX_MODEL=
CREATIVE_RUNWAY_API_KEY=
CREATIVE_RUNWAY_MODEL=

# 任意: roleごとのText Provider/Model設定（JSON）。空なら既存LLM設定を使います。
CREATIVE_TEXT_ROLE_MODELS={}

# AI Publishing, Scheduling & Performance Learning System
# 安全初期値。OAuth設定前・Sandbox試験前にtrueへ変更しないでください。
PUBLISHING_ENABLED=false
PUBLISHING_EXTERNAL_API_ENABLED=false
PUBLISHING_DRY_RUN=true
PUBLISHING_AUTONOMY=assisted
PUBLISHING_DEFAULT_TIMEZONE=Asia/Tokyo
PUBLISHING_MAX_RETRIES=3
PUBLISHING_RETRY_BASE_SECONDS=30
PUBLISHING_MAX_SCHEDULE_LATENESS_MINUTES=15
PUBLISHING_DUPLICATE_WINDOW_DAYS=30
PUBLISHING_EXPLORATION_RATIO=0.2
PUBLISHING_PERFORMANCE_WINDOWS=1h,6h,24h,72h,7d,30d
PUBLISHING_ALLOW_REMOTE_DELETE=false
PUBLISHING_WORKER_POLL_SECONDS=15
PUBLISHING_WORKER_LEASE_SECONDS=120
PUBLISHING_WORKER_BATCH_SIZE=10
PUBLISHING_WORKER_STALE_SECONDS=90
PUBLISHING_NOTIFICATION_MAX_ATTEMPTS=3
PUBLISHING_PLATFORM_CAPABILITIES={}

# 以下はProduction Publisherの審査・Sandbox試験を終えた最後の接続作業用です。
# 初期ゲートとDry Runが有効な間は、値を設定しても外部投稿しません。
PUBLISHING_X_API_BASE_URL=https://api.x.com/2
X_CLIENT_ID=
X_CLIENT_SECRET=
# X Developer Portalへ完全一致で登録するCallback URLです。
X_REDIRECT_URI=http://localhost:8501/publishing_center
X_OAUTH_ACCESS_TOKEN=

META_APP_ID=
META_APP_SECRET=
# Meta AppのValid OAuth Redirect URIへ完全一致で登録します。
META_REDIRECT_URI=http://localhost:8501/publishing_center
PUBLISHING_META_GRAPH_API_VERSION=v26.0
PUBLISHING_INSTAGRAM_API_BASE_URL=https://graph.instagram.com
PUBLISHING_OAUTH_TIMEOUT_SECONDS=30

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok Desktop Loginはlocalhost/127.0.0.1とportの完全一致が必要です。
# Web Appとして登録した場合は、TikTok Consoleへ登録した固定HTTPS callbackへ変更します。
TIKTOK_REDIRECT_URI=http://127.0.0.1:8501/publishing_center
TIKTOK_OAUTH_USE_PKCE=true
# TikTokのContent Posting API監査が承認されるまではfalseのままにします。
TIKTOK_CLIENT_AUDITED=false
PUBLISHING_TIKTOK_API_BASE_URL=https://open.tiktokapis.com/v2
# Developer App website: https://note-to-automation.laugh-eternal0801.workers.dev
# Privacy Policy: https://note-to-automation.laugh-eternal0801.workers.dev/privacy
# Terms of Service: https://note-to-automation.laugh-eternal0801.workers.dev/terms

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=
PINTEREST_OAUTH_CONTINUOUS_REFRESH=true

REDDIT_REDIRECT_URI=

# 任意: 自動分析したnote記事構成ガイドの取得先です。
NOTE_FORMAT_PLAYBOOK_URL=https://raw.githubusercontent.com/laugheternal0801-tech/rakuten-affiliate-content-manager/note-format-data/data/note_format_playbook.json
NOTE_FORMAT_PLAYBOOK_TIMEOUT_SECONDS=3
