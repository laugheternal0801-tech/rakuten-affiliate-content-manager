RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# 任意: 楽天市場商品検索APIのバージョン変更時に上書きできます。
RAKUTEN_API_ENDPOINT=https://openapi.rakuten.co.jp/ichibams/api/IchibaItem/Search/20260701
RAKUTEN_API_TIMEOUT_SECONDS=10
RAKUTEN_API_CACHE_TTL_SECONDS=900

# 任意: Claude Sonnet 5で投稿案を生成します。未設定時はテンプレート生成を使います。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_TIMEOUT_SECONDS=120

# 任意: GPT Image 2でnote記事のアイキャッチ画像を生成します。
OPENAI_API_KEY=
OPENAI_IMAGE_TIMEOUT_SECONDS=150

# 任意: 自動分析したnote記事構成ガイドの取得先です。
NOTE_FORMAT_PLAYBOOK_URL=https://raw.githubusercontent.com/laugheternal0801-tech/rakuten-affiliate-content-manager/note-format-data/data/note_format_playbook.json
NOTE_FORMAT_PLAYBOOK_TIMEOUT_SECONDS=3
